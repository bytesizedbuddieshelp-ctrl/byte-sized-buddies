---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import { copy } from '../content/copy';

const t = copy.visitList;
---

<Base title={t.title} description={t.description}>
  <div class="container section">
    <div class="with-aside">
      <div class="prose checklist-page">
        <h1>{t.title}</h1>
        <p class="lead">{t.intro}</p>
        <div class="actions screen-only">
          <button type="button" class="button button-primary" data-print>{t.print}</button>
        </div>
        {
          t.groups.map((group, g) => (
            <section aria-labelledby={`group-${g}`} class="checklist-group">
              <h2 id={`group-${g}`}>{group.title}</h2>
              <ul class="tick-list">
                {group.items.map((item, i) => (
                  <li>
                    <label>
                      <input type="checkbox" />
                      <span>{item}</span>
                    </label>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
      <aside class="aside-sticky aside-stack screen-only" aria-label="More help">
        <div class="sheet">
          <h2 class="aside-heading">{t.card.heading}</h2>
          <p>{t.card.text}</p>
          <Button variant="secondary" href={t.card.href}>{t.card.button}</Button>
        </div>
      </aside>
    </div>
  </div>
</Base>

<script>
  document.querySelectorAll('[data-print]').forEach((b) => b.addEventListener('click', () => window.print()));
</script>
