---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Card from '../components/Card.astro';
import { copy } from '../content/copy';

const t = copy.lessons;
---

<Base title={t.title} description={t.description}>
  <div class="container section">
    <div class="prose">
      <h1>{t.title}</h1>
      <!-- Phase 3 replaces this card with the lesson library from the database. -->
      <Card>
        <h2>{t.emptyTitle}</h2>
        <p>{t.emptyText}</p>
        <Button variant="secondary" href="/teach">{t.teachButton}</Button>
      </Card>
    </div>
  </div>
</Base>
