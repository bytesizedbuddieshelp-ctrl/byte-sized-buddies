---
import '../styles/global.css';
import Header from '../components/Header.astro';
import TextSize from '../components/TextSize.astro';
import Footer from '../components/Footer.astro';
import { copy } from '../content/copy';
import fraunces from '../../brand/fonts/Fraunces-Soft.woff2?url';
import atkinsonRegular from '../../brand/fonts/AtkinsonHyperlegible-Regular.woff2?url';
import atkinsonBold from '../../brand/fonts/AtkinsonHyperlegible-Bold.woff2?url';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title = copy.siteName, description = copy.home.description, noindex = false } = Astro.props;
const fullTitle = title === copy.siteName ? title : `${title} | ${copy.siteName}`;

// Absolute addresses only work once PUBLIC_SITE_URL is set (see README). Without it, we leave them out.
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).href : undefined;
const shareImage = site ? new URL('/og-image.png', site).href : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:site_name" content={copy.siteName} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {shareImage && <meta property="og:image" content={shareImage} />}
    {shareImage && <meta property="og:image:width" content="1200" />}
    {shareImage && <meta property="og:image:height" content="630" />}
    {shareImage && <meta property="og:image:alt" content="Byte-Sized Buddies. Learn it. Try it. Keep it." />}
    <slot name="head" />
    <meta name="twitter:card" content={shareImage ? 'summary_large_image' : 'summary'} />
    <link rel="preload" href={fraunces} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={atkinsonRegular} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={atkinsonBold} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a href="#main" class="skip-link">{copy.skipLink}</a>
    <TextSize />
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: var(--space-3);
    top: var(--space-3);
    z-index: 100;
    padding: var(--space-3) var(--space-4);
    min-height: 56px;
    display: inline-flex;
    align-items: center;
    background: var(--forest-deep);
    color: var(--cream);
    font-size: 18px;
    font-weight: 700;
    border-radius: var(--radius-md);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: translateY(0);
  }
</style>
