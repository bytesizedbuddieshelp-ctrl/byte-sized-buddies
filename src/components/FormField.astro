---
import Icon from './Icon.astro';
import { copy } from '../content/copy';

// A labeled text field. The label is always visible (never placeholder-only).
// Errors say what is wrong in words and show an icon next to the field.
interface Props {
  id: string;
  name?: string;
  label: string;
  type?: 'text' | 'email' | 'tel' | 'url' | 'number';
  as?: 'input' | 'textarea';
  required?: boolean;
  helper?: string;
  error?: string;
  value?: string;
  autocomplete?: string;
  rows?: number;
  maxlength?: number;
}

const {
  id,
  name = id,
  label,
  type = 'text',
  as = 'input',
  required = false,
  helper,
  error,
  value,
  autocomplete,
  rows = 5,
  maxlength,
} = Astro.props;

const helperId = helper ? `${id}-helper` : undefined;
const errorId = error ? `${id}-error` : undefined;
const describedBy = [helperId, errorId].filter(Boolean).join(' ') || undefined;
---

<div class="field">
  <label for={id} class="field-label">
    {label}
    {required && <span class="field-required"> {copy.form.required}</span>}
  </label>
  {helper && <p id={helperId} class="field-helper">{helper}</p>}
  {
    as === 'textarea' ? (
      <textarea
        id={id}
        name={name}
        rows={rows}
        required={required}
        maxlength={maxlength}
        aria-describedby={describedBy}
        aria-invalid={error ? 'true' : undefined}
        class="field-control"
      >{value}</textarea>
    ) : (
      <input
        id={id}
        name={name}
        type={type}
        value={value}
        required={required}
        maxlength={maxlength}
        autocomplete={autocomplete}
        aria-describedby={describedBy}
        aria-invalid={error ? 'true' : undefined}
        class="field-control"
      />
    )
  }
  {
    error && (
      <p id={errorId} class="field-error">
        <Icon name="alert" size={24} />
        <span>
          <span class="visually-hidden">{copy.form.errorPrefix} </span>
          {error}
        </span>
      </p>
    )
  }
</div>

<style is:global>
  .field {
    margin-bottom: var(--space-4);
  }

  .field-label {
    display: block;
    margin-bottom: var(--space-2);
    font-size: 18px;
    line-height: 24px;
    font-weight: 700;
    color: var(--ink);
  }

  .field-required {
    font-weight: 400;
    color: var(--ink-muted);
  }

  .field-helper {
    margin: 0 0 var(--space-2);
    font-size: 18px;
    line-height: 26px;
    color: var(--ink-muted);
  }

  .field-control {
    display: block;
    width: 100%;
    min-height: 56px;
    padding: var(--space-2) var(--space-3);
    border: 2px solid var(--ink-muted);
    border-radius: var(--radius-sm);
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 20px;
    line-height: 30px;
  }

  textarea.field-control {
    resize: vertical;
  }

  .field-control[aria-invalid='true'] {
    border: 3px solid var(--brick);
  }

  .field-error {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    margin: var(--space-2) 0 0;
    font-size: 18px;
    line-height: 26px;
    font-weight: 700;
    color: var(--brick);
  }

  .field-error svg {
    flex: none;
    margin-top: 1px;
  }
</style>
