---
// The one Icon component. Outlined, 2.5px stroke, round caps.
// Icons are decoration: always put a visible text label next to them.
import { iconPaths, type IconName } from '../lib/icons';

export type { IconName };

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 28, class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
  set:html={iconPaths[name]}
/>
