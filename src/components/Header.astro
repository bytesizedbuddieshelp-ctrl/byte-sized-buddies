---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import Button from './Button.astro';
import { copy } from '../content/copy';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = (href: string) => (href.split('#')[0] === path ? 'page' : undefined);
---

<header class="site-header">
  <div class="container site-header-inner">
    <a href="/" class="logo-link" aria-label={copy.logoHomeLabel}>
      <Logo variant="horizontal" width={200} alt="" class="site-logo" />
    </a>

    <nav class="site-nav" aria-label={copy.nav.label}>
      <ul>
        {
          copy.nav.items.map((item) => (
            <li>
              <a href={item.href} aria-current={current(item.href)}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <Button href={copy.nav.visit.href} class="site-visit">{copy.nav.visit.label}</Button>

    <button
      type="button"
      id="menu-open"
      class="button button-secondary menu-open"
      aria-haspopup="dialog"
      aria-controls="menu-dialog"
      aria-expanded="false"
    >
      <Icon name="menu" size={24} />
      <span>{copy.nav.menuOpen}</span>
    </button>
  </div>

  <dialog id="menu-dialog" class="menu-dialog" aria-label={copy.nav.menuOpen}>
    <div class="menu-top">
      <button type="button" id="menu-close" class="button button-secondary menu-close">
        <Icon name="close" size={24} />
        <span>{copy.nav.menuClose}</span>
      </button>
    </div>
    <nav aria-label={copy.nav.label}>
      <ul class="menu-list">
        {
          copy.nav.items.map((item) => (
            <li>
              <a href={item.href} aria-current={current(item.href)}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <Button href={copy.nav.visit.href} class="menu-visit">{copy.nav.visit.label}</Button>
  </dialog>
</header>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#menu-dialog');
  const openButton = document.querySelector<HTMLButtonElement>('#menu-open');
  const closeButton = document.querySelector<HTMLButtonElement>('#menu-close');
  const wide = window.matchMedia('(min-width: 1100px)');

  if (dialog && openButton && closeButton) {
    // showModal() traps focus inside the dialog, Escape closes it, and focus goes back to the Menu button.
    openButton.addEventListener('click', () => {
      dialog.showModal();
      openButton.setAttribute('aria-expanded', 'true');
    });
    closeButton.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => openButton.setAttribute('aria-expanded', 'false'));
    // A link to the page you are already on would leave the menu open, so close it first.
    dialog.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => dialog.close()));
    // Keep Tab and Shift+Tab going around inside the menu instead of leaving it.
    dialog.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab') return;
      const items = Array.from(dialog.querySelectorAll<HTMLElement>('a[href], button'));
      const first = items[0];
      const last = items[items.length - 1];
      const active = document.activeElement;
      if (event.shiftKey && (active === first || !dialog.contains(active))) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && (active === last || !dialog.contains(active))) {
        event.preventDefault();
        first.focus();
      }
    });
    wide.addEventListener('change', () => {
      if (wide.matches && dialog.open) dialog.close();
    });
  }
</script>

<style is:global>
  .site-header {
    background: var(--cream);
    border-bottom: 2px solid var(--rule);
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-3);
    flex-wrap: wrap;
  }

  .logo-link {
    display: block;
    padding: var(--space-2) 0;
    line-height: 0;
  }

  .site-logo {
    width: 200px;
  }

  .site-nav,
  .site-visit {
    display: none;
  }

  /* Menu button: a compact toggle so the logo and button fit side by side at 320px. */
  .menu-open {
    min-width: 0;
    padding-inline: var(--space-3);
  }

  .menu-dialog {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: var(--space-3) var(--space-4) var(--space-5);
    border: 0;
    background: var(--cream);
    color: var(--ink);
    overflow-y: auto;
  }

  .menu-dialog[open] {
    display: block;
  }

  .menu-top {
    display: flex;
    justify-content: flex-end;
    margin-bottom: var(--space-3);
  }

  .menu-close {
    min-width: 0;
    padding-inline: var(--space-4);
    white-space: nowrap;
  }

  .menu-close svg,
  .menu-open svg {
    flex: none;
  }

  .menu-list {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
  }

  .menu-list li {
    border-bottom: 2px solid var(--rule);
  }

  .menu-list a {
    display: flex;
    align-items: center;
    min-height: 64px;
    font-size: 22px;
    font-weight: 700;
    text-decoration: none;
    color: var(--forest);
  }

  .menu-list a[aria-current='page'],
  .site-nav a[aria-current='page'] {
    text-decoration: underline;
    text-decoration-thickness: 3px;
  }

  .menu-visit {
    width: 100%;
  }

  html:has(dialog[open]) {
    overflow: hidden;
  }

  @media (max-width: 420px) {
    .site-header-inner {
      padding-inline: var(--space-3);
      gap: 12px;
    }

    .menu-open {
      padding-inline: 12px;
    }

    .site-logo {
      width: 160px;
    }
  }

  @media (min-width: 1100px) {
    .menu-open,
    .menu-dialog {
      display: none !important;
    }

    .site-nav {
      display: block;
      margin-left: auto;
    }

    .site-nav ul {
      display: flex;
      align-items: center;
      gap: var(--space-1);
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .site-nav a {
      display: inline-flex;
      align-items: center;
      min-height: 48px;
      padding: 0 var(--space-3);
      font-size: 18px;
      line-height: 24px;
      font-weight: 700;
      text-decoration: none;
      border-radius: var(--radius-sm);
    }

    .site-nav a:hover {
      text-decoration: underline;
      text-decoration-thickness: 2px;
    }

    .site-visit {
      display: inline-flex;
    }
  }
</style>
