---
// A flat paper card. A 2px rule line under it, no blur.
interface Props {
  as?: 'div' | 'article' | 'section' | 'li';
  class?: string;
  [attr: string]: unknown;
}

const { as: Tag = 'div', class: className, ...rest } = Astro.props;
---

<Tag class:list={['card', className]} {...rest}>
  <slot />
</Tag>
