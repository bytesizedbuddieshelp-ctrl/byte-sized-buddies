---
import Logo from './Logo.astro';
import { copy } from '../content/copy';

const f = copy.footer;
---

<footer class="site-footer on-dark">
  <div class="container">
    <div class="site-footer-grid">
      <div class="site-footer-brand">
        <Logo variant="mark-reversed" width={56} alt="" />
        <p class="site-footer-tagline">{copy.tagline}</p>
        <p class="site-footer-mission">{f.mission}</p>
        <p class="site-footer-small">{f.studentLed}</p>
      </div>
      <nav aria-labelledby="footer-explore">
        <h2 id="footer-explore" class="site-footer-heading">{f.exploreHeading}</h2>
        <ul class="site-footer-links">
          {
            [...copy.nav.items, copy.nav.visit].map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
      <nav aria-labelledby="footer-site">
        <h2 id="footer-site" class="site-footer-heading">{f.linksHeading}</h2>
        <ul class="site-footer-links">
          {
            f.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
    <p class="site-footer-line">{f.line}</p>
  </div>
</footer>

<style is:global>
  .site-footer {
    background: var(--forest-deep);
    color: var(--cream);
    padding-block: var(--space-7) var(--space-5);
  }

  .site-footer-grid {
    display: grid;
    gap: var(--space-6);
  }

  @media (min-width: 900px) {
    .site-footer-grid {
      grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-7);
    }
  }

  .site-footer-brand .logo-tile,
  .site-footer-brand img {
    margin-bottom: var(--space-3);
  }

  .site-footer-tagline {
    margin: 0 0 var(--space-2);
    font-family: var(--font-display);
    font-size: 28px;
    line-height: 36px;
    font-weight: 700;
    color: var(--cream);
  }

  .site-footer-mission {
    max-width: 30rem;
    margin: 0 0 var(--space-3);
  }

  .site-footer-heading {
    margin: 0 0 var(--space-2);
    font-size: 22px;
    line-height: 30px;
    color: var(--cream);
  }

  .site-footer-links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    color: var(--cream);
    font-size: 18px;
    font-weight: 700;
  }

  .site-footer a:hover {
    color: var(--paper);
    text-decoration-thickness: 3px;
  }

  .site-footer-small {
    margin: 0;
    font-size: 18px;
    line-height: 26px;
    color: var(--cream);
  }

  .site-footer-line {
    margin: var(--space-6) 0 0;
    padding-top: var(--space-4);
    border-top: 2px solid var(--forest);
    font-size: 18px;
    line-height: 26px;
    color: var(--cream);
  }
</style>
