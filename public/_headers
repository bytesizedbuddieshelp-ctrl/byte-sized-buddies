# Security headers for every page. Cloudflare reads this file.
# The main Content Security Policy (where scripts, pictures, and videos may come from) is added to each page
# by Astro; see astro.config.mjs. The rules below are ones a page can't set for itself.
/*
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), display-capture=(self), geolocation=(), payment=(), usb=()

# Private pages stay out of search engines (they also say so in the page).
/admin
  X-Robots-Tag: noindex
/admin/*
  X-Robots-Tag: noindex
/answer
  X-Robots-Tag: noindex

# Built files have a fingerprint in their name, so browsers may keep them for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
